# CVR API Credentials
# Copy this file to .env and fill in your actual credentials
# Never commit .env to version control!

# Your CVR API credentials (obtain from cvrselvbetjening@erst.dk)
CVR_USERNAME=YOUR_USERNAME_HERE
CVR_PASSWORD=YOUR_PASSWORD_HERE

# API Configuration
CVR_BASE_URL=http://distribution.virk.dk/cvr-permanent

# Optional: Rate limiting and timeout settings
CVR_TIMEOUT=30
CVR_MAX_RETRIES=3
CVR_RATE_LIMIT_DELAY=0.2

# Optional: Cache settings (if using Redis)
REDIS_URL=redis://localhost:6379
CVR_CACHE_TTL=3600

# Optional: Development settings
DEBUG=false
LOG_LEVEL=info